# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in the secret values
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=                       # Required — get from console.groq.com
LLM_PROVIDER=groq
LLM_MODEL=                          # Leave empty; fill after running check_models.py

# ── Embeddings ────────────────────────────────────────────────────────────────
HF_TOKEN=                           # Required — get from huggingface.co/settings/tokens
EMBEDDING_MODEL=                    # Leave empty; fill after running check_models.py
EMBEDDING_MODE=hf_inference_api     # Options: hf_inference_api | local

# ── Paths ─────────────────────────────────────────────────────────────────────
CHROMA_PATH=./data/chroma           # ChromaDB persistent storage directory
SQLITE_PATH=./data/app.db           # SQLite database for approved reply history
KB_PATH=./data/1_support_kb_tow.md  # Path to your knowledge base markdown file

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                      # Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_DIR=./logs                      # Directory for rotating log files

# ── Pipeline behaviour ────────────────────────────────────────────────────────
DEBOUNCE_SECONDS=4                  # Seconds to wait before processing a new message

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5                   # Number of KB chunks returned per retrieval pass
BM25_TOP_K=5                        # BM25 candidate pool size

# ── HTTP / retry ──────────────────────────────────────────────────────────────
HTTP_TIMEOUT_SECONDS=30             # Timeout for all outbound HTTP calls (seconds)
MAX_RETRIES=3                       # Max retry attempts on transient errors (5xx, 429)
RETRY_BACKOFF_SECONDS=2             # Base back-off between retries (exponential)

# ── Groq rate-limit safety ────────────────────────────────────────────────────
GROQ_RPM_LIMIT=30                   # Max requests/min to stay under; adjust after check

# ── Embedding batching ────────────────────────────────────────────────────────
EMBED_BATCH_SIZE=32                 # Number of texts sent per HF Inference API call
